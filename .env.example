# Atlas Depeche — environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Admin auth (Phase 4 — SECURITY FIRST) ---

# Username for /admin login. Both vars must be set for admin auth to work.
# If unset, /admin is unprotected (the original state — fine for local dev
# with no deployed site, but must be set before any public deployment).
# ADMIN_USER=admin

# SHA-256 hash of the admin password. Generate with:
#   node -e "require('crypto').createHash('sha256').update('your-password').digest('hex')"
# or (in the project):
#   npx tsx -e "import { sha256hex } from './src/lib/admin-auth'; sha256hex('your-password').then(console.log)"
# ADMIN_PASSWORD_HASH=...

# --- Phase 0: bootstrap ---

# PostgreSQL connection string. Local dev: run Postgres yourself (Docker or
# native) and point this at it, or use a Railway/managed dev database.
# Required for `npm run db:migrate` / `npm run db:push`; not required for
# `npm run db:generate` (schema-to-SQL only, no live connection).
DATABASE_URL=postgres://user:password@localhost:5432/atlas_depeche

# development | test | production
NODE_ENV=development

# Global default publication mode (see CLAUDE.md — Publication Modes).
# One of: shadow | assisted | automated | human_only
# Must start as "shadow" in every new environment. Never default to
# "automated" via env var alone — automated mode is opt-in per category
# in code, not a blanket switch.
PUBLICATION_MODE=shadow

# Port for `next start` (dev server uses Next's default unless overridden).
PORT=3000

# --- Phase 1: radar / ingest (all optional — sane defaults in code) ---

# Identifies the radar's HTTP client to source servers. Keep it truthful and
# reachable (points at the repo) — see src/ingest/fetch-utils.ts.
# RADAR_USER_AGENT="Mozilla/5.0 (compatible; AtlasDepecheBot/0.1; +https://github.com/atlasdepeche/atlas-depeche)"

# Per-request timeout / response size cap for the polite fetch layer.
# RADAR_FETCH_TIMEOUT_MS=10000
# RADAR_MAX_RESPONSE_BYTES=2000000

# --- Phase 2: verify + knowledge ---

# Required for `npm run verify:dry-run` / `npm run verify:once` — the
# Verification and Adversarial agents call the Anthropic API. Not required
# to build, lint, test, or run the radar. See CLAUDE.md — Agent rules.
# The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile
# instead of a bare API key; see src/agents/anthropic-client.ts.
ANTHROPIC_API_KEY=

# Model used by each agent. Default is the strong tier from MASTER_PROMPT
# section 38 ("strong model: verification, adversarial check...") — these
# are the accuracy-critical agents, so this intentionally does not default
# to the cheapest option. Override to claude-sonnet-5 to cut cost if the
# daily spend gets uncomfortable.
# ANTHROPIC_VERIFICATION_MODEL=claude-opus-5
# ANTHROPIC_ADVERSARIAL_MODEL=claude-opus-5

# Hard spend caps in USD, enforced by src/agents/cost-guard.ts — see
# MASTER_PROMPT section 38. Once the daily cap is hit the worker stops
# starting new agent runs (ingest keeps working); once the per-event cap is
# hit after verification, that event's adversarial pass is skipped rather
# than run unconditionally.
# AGENT_MAX_COST_USD_PER_DAY=5
# AGENT_MAX_COST_USD_PER_EVENT=0.5

# --- Phase 3: write + CMS ---

# Model for the Arabic Fusha / French Writer Agent. Same reasoning as the
# verification models above (MASTER_PROMPT section 38's "strong model" tier
# — writing is accuracy- and register-sensitive, not a cheap-tier task).
# ANTHROPIC_WRITER_MODEL=claude-opus-5

# --- Phase 4: public site ---

# Absolute base URL used to build links/GUIDs in the per-locale RSS feeds.
# Defaults to http://localhost:3000 if unset — fine for local dev, wrong for
# anything else.
# SITE_URL=http://localhost:3000

# --- Phase 5: distribution + observability ---

# Both channels are off by default and require BOTH the flag AND all of
# that channel's credentials to actually post — see
# src/distribution/{x,telegram}.ts. `npm run distribute:once` still runs
# safely with everything below unset: it just records status="disabled"
# for every article/channel pair, which /admin/analytics can show.

# DISTRIBUTION_X_ENABLED=true
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# DISTRIBUTION_TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Added 2026-09-19. Different data source than X/Telegram above — see
# src/workers/instagram-publish.ts's top comment: posts straight from the
# free-aggregator radar (`npm run instagram:once`), not from `articles`.
# Real setup the user has to complete on Instagram/Meta's side first (none
# of it can be provisioned from here) — see src/distribution/instagram.ts's
# top comment for the exact steps: convert @atlasdepeche to a Professional
# account, connect it to a Facebook Page, create a Meta developer app with
# Instagram content-publishing permissions, get a long-lived access token
# and the account's numeric Business Account ID (not the @handle).
# DISTRIBUTION_INSTAGRAM_ENABLED=true
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# INSTAGRAM_ACCESS_TOKEN=

# --- Phase 6: careful automation ---
# See src/lib/automation-policy.ts. Both defaults below mean automation is
# OFF — nothing auto-publishes until BOTH are explicitly set, on top of the
# permanent HUMAN_ONLY_CATEGORIES list (politics/justice/security/
# diplomacy) that no env var can override.

# The master kill switch. Must be the exact string "false" to un-kill —
# unset, empty, or any other value all mean automation stays off.
# AUTOMATION_KILL_SWITCH=false

# Comma-separated categories AUTOMATED mode may apply to regardless of
# confidence (path 1). Keep this to the deliberately boring categories
# MASTER_PROMPT section 41 names — weather bulletins, official agendas,
# sports scores from an official federation — never politics, even with
# the kill switch off.
# AUTOMATED_CATEGORIES=weather

# Path 2 (added 2026-09-18): ANY non-human-only category auto-publishes if
# verification confidence is >= this value AND the Adversarial Agent found
# ZERO concerns (events.adversarial_concern_count === 0, not just no
# high-severity ones — see src/lib/automation-policy.ts). Defaults to 90
# if unset. Still fully gated by AUTOMATION_KILL_SWITCH and the permanent
# HUMAN_ONLY_CATEGORIES list.
# AUTOMATED_MIN_CONFIDENCE=90

# --- Later phases (not read by any code yet; kept here as a map of what's
# coming so this file stays the single source of truth for config) ---
# REDIS_URL (Phase 1+: job queues, once polling volume needs a real queue)
# OBJECT_STORAGE_* (Phase 3+: media)

# --- Advertising module (added 2026-09-22) --------------------------------
# Completely independent from the editorial system. All vars optional for
# local dev — the template renderer needs no external APIs.

# Video generation provider. "template" is free and always available.
# "veo" requires Google Cloud credentials (when Veo API becomes available).
# AD_VIDEO_PROVIDER=template

# Google Veo (future — not yet available via API)
# GOOGLE_CLOUD_PROJECT=
# VEO_API_KEY=

# Cost control — per-company daily limits
# AD_DAILY_COST_LIMIT_USD=5
# AD_MAX_GENERATIONS_PER_DAY=10
