# Atlas Depeche — environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Phase 0: bootstrap ---

# PostgreSQL connection string. Local dev: run Postgres yourself (Docker or
# native) and point this at it, or use a Railway/managed dev database.
# Required for `npm run db:migrate` / `npm run db:push`; not required for
# `npm run db:generate` (schema-to-SQL only, no live connection).
DATABASE_URL=postgres://user:password@localhost:5432/atlas_depeche

# development | test | production
NODE_ENV=development

# Global default publication mode (see CLAUDE.md — Publication Modes).
# One of: shadow | assisted | automated | human_only
# Must start as "shadow" in every new environment. Never default to
# "automated" via env var alone — automated mode is opt-in per category
# in code, not a blanket switch.
PUBLICATION_MODE=shadow

# Port for `next start` (dev server uses Next's default unless overridden).
PORT=3000

# --- Later phases (not read by any code yet; kept here as a map of what's
# coming so this file stays the single source of truth for config) ---
# LLM provider keys (Phase 2+: verification, writing agents)
# REDIS_URL (Phase 1+: job queues)
# OBJECT_STORAGE_* (Phase 3+: media)
# X_API_*, TELEGRAM_BOT_TOKEN (Phase 5: distribution)
